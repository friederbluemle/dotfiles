        "customText": "|"
      },
      {
        "id": "cwd-widget",
        "type": "custom-command",
        "color": "blue",
        "commandPath": "r=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P); n=$(basename \"$r\"); [ \"$r\" = \"$(pwd -P)\" ] && echo \"$n\" || echo \"$n:${PWD##*/}\""
      },
      {
        "id": "cwd-sep",
        "type": "custom-text",
        "customText": "|"
      },
      {
