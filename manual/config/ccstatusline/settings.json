{
  "version": 4,
  "lines": [
    [
      {
        "id": "model",
        "type": "model",
        "color": "cyan",
        "rawValue": true,
        "merge": false
      },
      {
        "id": "thinking-effort",
        "type": "thinking-effort",
        "color": "magenta",
        "rawValue": true,
        "merge": true
      },
      {
        "id": "model-ver-open",
        "type": "custom-text",
        "color": "brightBlack",
        "customText": " (",
        "merge": true
      },
      {
        "id": "version",
        "type": "version",
        "color": "brightBlack",
        "rawValue": true,
        "merge": true
      },
      {
        "id": "model-ver-close",
        "type": "custom-text",
        "color": "brightBlack",
        "customText": ")"
      },
      {
        "id": "sep-model-cwd",
        "type": "custom-text",
        "customText": "|"
      },
      {
        "id": "cwd-widget",
        "type": "custom-command",
        "color": "blue",
        "commandPath": "r=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P); n=$(basename \"$r\"); [ \"$r\" = \"$(pwd -P)\" ] && echo \"$n\" || echo \"$n:${PWD##*/}\""
      },
      {
        "id": "cwd-sep",
        "type": "custom-text",
        "customText": "|"
      },
      {
        "id": "git-branch",
        "type": "git-branch",
        "color": "green",
        "rawValue": true,
        "metadata": {
          "hide": "no-git"
        },
        "maxWidth": 25
      },
      {
        "id": "git-changes",
        "type": "git-changes",
        "color": "yellow",
        "rawValue": true,
        "metadata": {
          "hide": "no-git"
        }
      },
      {
        "id": "git-ahead-behind",
        "type": "git-ahead-behind",
        "color": "magenta",
        "metadata": {
          "hide": "no-git,no-upstream,zero"
        }
      },
      {
        "id": "flex-1",
        "type": "flex-separator"
      },
      {
        "id": "session-id",
        "type": "custom-command",
        "color": "brightBlack",
        "commandPath": "jq -r '.session_id[0:8]'"
      }
    ],
    [
      {
        "id": "ctx-pct",
        "type": "context-percentage-usable",
        "color": "green",
        "rawValue": true
      },
      {
        "id": "compaction-counter",
        "type": "compaction-counter",
        "color": "yellow",
        "rawValue": true,
        "metadata": {
          "hide": "zero"
        }
      },
      {
        "id": "sep-ctx-cost",
        "type": "custom-text",
        "customText": "|"
      },
      {
        "id": "session-cost",
        "type": "session-cost",
        "color": "green",
        "rawValue": true
      },
      {
        "id": "sep-cost-time",
        "type": "custom-text",
        "customText": "|"
      },
      {
        "id": "session-clock",
        "type": "session-clock",
        "color": "blue",
        "rawValue": true
      },
      {
        "id": "sep-time-cache",
        "type": "custom-text",
        "customText": "|"
      },
      {
        "id": "cache-timer",
        "type": "cache-timer",
        "color": "brightCyan",
        "rawValue": true,
        "metadata": {
          "ttlSeconds": "3600"
        }
      },
      {
        "id": "cache-hit-open",
        "type": "custom-text",
        "color": "brightBlack",
        "customText": "(",
        "merge": true
      },
      {
        "id": "cache-hit-rate",
        "type": "cache-hit-rate",
        "color": "brightBlack",
        "rawValue": true,
        "merge": true
      },
      {
        "id": "cache-hit-close",
        "type": "custom-text",
        "color": "brightBlack",
        "customText": ")"
      },
      {
        "id": "flex-2",
        "type": "flex-separator"
      },
      {
        "id": "usage-5h-label",
        "type": "custom-text",
        "color": "brightBlack",
        "customText": "5h"
      },
      {
        "id": "session-usage",
        "type": "session-usage",
        "color": "brightBlue",
        "rawValue": true,
        "metadata": {
          "display": "slider",
          "cursor": "true"
        }
      },
      {
        "id": "reset-timer",
        "type": "reset-timer",
        "color": "brightBlack",
        "rawValue": true,
        "metadata": {
          "compact": "true"
        }
      },
      {
        "id": "sep-5h-7d",
        "type": "custom-text",
        "customText": "|"
      },
      {
        "id": "usage-7d-label",
        "type": "custom-text",
        "color": "brightBlack",
        "customText": "7d"
      },
      {
        "id": "weekly-usage",
        "type": "weekly-usage",
        "color": "brightBlue",
        "rawValue": true
      },
      {
        "id": "weekly-reset-timer",
        "type": "weekly-reset-timer",
        "color": "brightBlack",
        "rawValue": true,
        "metadata": {
          "compact": "true"
        }
      }
    ],
    []
  ],
  "flexMode": "full-minus-40",
  "compactThreshold": 60,
  "colorLevel": 3,
  "defaultSeparator": " ",
  "inheritSeparatorColors": false,
  "globalBold": false,
  "powerline": {
    "enabled": false,
    "separators": [
      ""
    ],
    "separatorInvertBackground": [
      false
    ],
    "startCaps": [],
    "endCaps": [],
    "autoAlign": false
  }
}
